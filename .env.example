# Base
APP_URL=http://localhost:3000
DATA_DIR=./data
# Gera com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (se ficar vazio ou com este texto de exemplo, a app gera um segredo próprio em DATA_DIR)
SESSION_SECRET=troca-por-uma-string-aleatoria-com-32+-caracteres
# Chave para cifrar contactos e ficheiros em repouso (gera da mesma forma). GUARDA-A: sem ela os dados cifrados não se recuperam.
DATA_ENCRYPTION_KEY=
# Número de proxies à frente da app (Render: 1). Usado para saber o IP real nos limites de tentativas.
TRUST_PROXY_HOPS=1
# Admin inicial (usado só pelo seed)
ADMIN_EMAIL=admin@cartaqr.local
# Mínimo 12 caracteres. A password de exemplo é recusada.
ADMIN_PASSWORD=troca-esta-password
# Para trocar a password de um admin existente: nova ADMIN_PASSWORD + ADMIN_RESET_PASSWORD=1, reinicia, e depois remove esta linha.
ADMIN_RESET_PASSWORD=
# IA (opcional). AI_PROVIDER: anthropic | mock | none
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
# Segredo para chamar /api/cron/expire (Authorization: Bearer <segredo>)
CRON_SECRET=
# Envio automático por WhatsApp Cloud API (opcional; sem isto só há links wa.me)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
